msgstr "ទទេ = ថ្ងៃនេះ"

msgid "Last working day must be YYYY-MM-DD."
msgstr "ថ្ងៃធ្វើការចុងក្រោយ ត្រូវតែជា YYYY-MM-DD។"

msgid "The last working day cannot be before the hire date."
msgstr "ថ្ងៃធ្វើការចុងក្រោយ មិនអាចមុនថ្ងៃចូលធ្វើការបានទេ។"

#, python-brace-format
msgid "Overtime ({hours:g} h)"
msgstr "ម៉ោងបន្ថែម ({hours:g} ម៉ោង)"

msgid "Income Tax (progressive)"
msgstr "ពន្ធលើប្រាក់បៀវត្សរ៍ (តាមកម្រិត)"

#, python-brace-format
msgid "Unpaid Days ({days:g})"
msgstr "ថ្ងៃមិនបើកប្រាក់ ({days:g})"

msgid "Progressive Tax Brackets (from:rate %, empty = flat rate above)"
msgstr "កម្រិតពន្ធ (ចាប់ពី:អត្រា % ទទេ = អត្រាថេរខាងលើ)"

msgid "Example in KHR: 0:0, 1500000:5, 2000000:10, 8500000:15, 12500000:20. Each rate applies to the part of monthly pay above its amount. Check current rates with your accountant."
msgstr "ឧទាហរណ៍ជារៀល៖ 0:0, 1500000:5, 2000000:10, 8500000:15, 12500000:20។ អត្រានីមួយៗអនុវត្តលើផ្នែកនៃប្រាក់ខែប្រចាំខែ ដែលលើសចំនួននោះ។ សូមផ្ទៀងផ្ទាត់អត្រាបច្ចុប្បន្នជាមួយគណនេយ្យករ។"

msgid "Tax bonus and overtime"
msgstr "យកពន្ធលើប្រាក់រង្វាន់ និងម៉ោងបន្ថែម"

msgid "Taxed like salary (off = base salary only)"
msgstr "យកពន្ធដូចប្រាក់ខែ (បិទ = តែប្រាក់ខែគោល)"

msgid "Health Insurance per Month"
msgstr "ធានារ៉ាប់រងសុខភាពប្រចាំខែ"

msgid "Health Insurance (higher salaries)"
msgstr "ធានារ៉ាប់រងសុខភាព (ប្រាក់ខែខ្ពស់)"

msgid "Higher Insurance from Base Salary"
msgstr "ធានារ៉ាប់រងខ្ពស់ ចាប់ពីប្រាក់ខែគោល"

msgid "Attendance in Payroll"
msgstr "វត្តមានក្នុងប្រាក់បៀវត្សរ៍"

msgid "Taken from attendance and leave when payroll is calculated"
msgstr "យកពីវត្តមាន និងច្បាប់ឈប់ ពេលគណនាប្រាក់បៀវត្សរ៍"

msgid "Deduct unpaid days"
msgstr "កាត់ថ្ងៃមិនបើកប្រាក់"

msgid "Absent and unpaid leave = 1 day, Half Day = 0.5 day (salary / working days)"
msgstr "អវត្តមាន និងច្បាប់ឈប់គ្មានប្រាក់ = 1 ថ្ងៃ កន្លះថ្ងៃ = 0.5 ថ្ងៃ (ប្រាក់ខែ / ថ្ងៃធ្វើការ)"

msgid "Overtime Pay Rate (x hourly rate, 0 = not paid)"
msgstr "អត្រាប្រាក់ម៉ោងបន្ថែម (x អត្រាម៉ោង, 0 = មិនបើក)"

msgid "Hourly rate = daily rate / shift hours (Attendance & Policies). Overtime counts after 'Overtime Counted After' and never on a Half Day."
msgstr "អត្រាម៉ោង = អត្រាថ្ងៃ / ម៉ោងវេន (វត្តមាន និងគោលការណ៍)។ ម៉ោងបន្ថែមរាប់ក្រោយ 'រាប់ម៉ោងបន្ថែមក្រោយ' ហើយមិនរាប់នៅថ្ងៃកន្លះថ្ងៃទេ។"

msgid "The selected dates contain no working days."
msgstr "កាលបរិច្ឆេទដែលបានជ្រើស មិនមានថ្ងៃធ្វើការទេ។"
